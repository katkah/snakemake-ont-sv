# PBS job output files
*.e[0-9]*
*.o[0-9]*

# Results and logs directories
results/
logs/
.snakemake/
*.pdf
*.png
*.svg

# Local run configs — copy from templates and fill in your paths
# These are gitignored so your real paths and sample names never end up in the repo
config/config.yaml
config/*.tsv
!config/samples.test.tsv
!config/units.test.tsv
run_*.sh
submit*.sh

# CI test dummy data — created on the fly by GitHub Actions, never commit real data here
# test/ directory itself is tracked (contains .gitkeep); test/data/ contents are not
test/data/
test/test_data/

# Python
