# Sequencing data — never commit these
*.bam
*.bai
*.fastq
*.fastq.gz
*.fasta
*.fa
*.fq
*.fq.gz
*.fa.gz
*.fasta.gz
*.sam
*.cram
*.fai
*.gzi
*.mmi
*.dict
*.csi
*.tbi

# Variant call files (results)
*.vcf
*.vcf.gz
*.vcf.gz.tbi
*.bcf
*.snf

# PBS job output files
*.e[0-9]*
*.o[0-9]*

# Results and logs directories
results/
logs/
.snakemake/
*.pdf
*.png
*.svg

# Local run configs — copy from templates and fill in your paths
# These are gitignored so your real paths and sample names never end up in the repo
config/config.yaml
config/*.tsv
!config/samples.test.tsv
!config/units.test.tsv
!config/samples.mini.tsv
!config/units.mini.tsv
run_*.sh
submit*.sh

# CI test dummy data — created on the fly by GitHub Actions, never commit real data here
# test/ directory itself is tracked (contains .gitkeep); test/data/ contents are not
test/data/
test/test_data/

# End-to-end test fixture — the one place real sequencing data IS committed.
# ~22 MB: two 70 kb slices of C. elegans WBcel235 (I:10,428,000-10,498,000 and
# IV:3,332,000-3,402,000) with the ONT reads that aligned there. These negations
# deliberately override the blanket data patterns at the top of this file, and
# work only because test/mini/ is not itself an ignored directory.
!test/mini/*.fa
!test/mini/*.fai
!test/mini/*.fastq.gz

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
*.so
.env
.venv
env/
venv/

