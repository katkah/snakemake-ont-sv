# =============================================================================
# ONT Structural Variant Pipeline — Configuration
# =============================================================================

# --- Sample sheet ---
samples: "config/samples.tsv"

# --- Reference genome ---
genome: "/path/to/genome/reference.fa"       # Reference genome FASTA
gap_file: "/path/to/genome/gaps.bed"         # Genome gap file (required for NanoVar)
                                             # Generate with: nanovar gaps reference.fa gaps.bed

# --- Organism (used for pyCirclize chromosome labels) ---
# Provide chromosome names and sizes (bp) matching your reference genome
# C. elegans WBcel235 example provided — edit for other organisms
chromosomes:
  I:   15072434
  II:  15279421
  III: 13783801
  IV:  17493829
  V:   20924180
  X:   17718942

# --- SV caller ---
# Options: sniffles2 | nanovar | cutesv
sv_caller: "sniffles2"

# --- SV filtering thresholds ---
min_sv_size: 50           # Minimum SV size in bp
min_support_reads: 3      # Minimum supporting reads

# --- Chromosomes to exclude from split-read links ---
# Mitochondrial DNA produces many split reads that are not informative for
# nuclear SV detection. Name varies by organism: MtDNA (C. elegans),
# chrM (human/mouse), MT (zebrafish).
exclude_chroms: ["MtDNA"]

# --- Visualization thresholds ---
min_inv_size: 1000        # Minimum inversion size to plot (bp)
min_dup_size: 1000        # Minimum duplication size to plot (bp)

# --- Truvari comparison (WT vs mutant, works for all callers) ---
# Unlike bcftools isec (exact POS/REF/ALT match), Truvari tolerates breakpoint
# wobble and compares size/sequence, so shared variants are not misreported as
# mutant-unique.
truvari:
  refdist: 500        # Max breakpoint distance for a match (bp)
  pctseq: 0.7         # Sequence similarity; needs the reference to resolve <DUP>/<INV>
  sizemax: 100000000  # Effectively unlimited (larger than any chromosome), so
                      # Truvari compares the same variants as bcftools isec.
                      # Truvari's own default of 50000 would silently drop
                      # larger SVs. Filter by size downstream instead, where
                      # it applies to every comparison method equally.

# --- minimap2 ---
minimap2_preset: "map-ont"
minimap2_threads: 15

# --- NanoVar (only used if sv_caller: nanovar) ---
nanovar_threads: 16

# --- Sniffles2 (only used if sv_caller: sniffles2) ---
sniffles2_threads: 16
sniffles2_joint_call: true   # Perform joint calling across all samples

# --- cuteSV (only used if sv_caller: cutesv) ---
cutesv_threads: 16

# --- Resources ---
# Memory in MB per rule — adjust for your machine or cluster.
# These values are passed to cluster schedulers (SLURM, PBS) via a cluster profile.
mem_mb:
  align:           16384   # minimap2 + samtools sort
  sniffles2:       16384   # per-sample SV calling
  sniffles2_joint: 32768   # joint calling across all samples
  nanovar:         32768   # NanoVar uses more memory than other callers
  cutesv:          16384   # per-sample SV calling
  compare:          4096   # bcftools isec
  split_reads:      8192   # samtools view + index
  sv_stats:         4096   # Python VCF parsing
  visualize:        4096   # pyCirclize plot
  nanoplot:         8192   # NanoPlot read QC
  coverage:         4096   # tinycov + samtools depth
  multiqc:          4096   # MultiQC aggregation
